# Convex deployment URL (from `npx convex dev` output)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# --- Convex Backend Secrets (set via `npx convex env set`) ---
# REPLICATE_API_KEY=r8_...
# ANTHROPIC_API_KEY=sk-ant-...

# Resend — for sending invite emails
# RESEND_KEY=re_...
# RESEND_FROM_EMAIL=Curie Lab <invites@yourdomain.com>  # defaults to onboarding@resend.dev

# Your app's public URL — used to build invite links in emails
# SITE_URL=https://your-app.vercel.app
